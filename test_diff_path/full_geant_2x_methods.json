{
  "schema_version": 2,
  "default_dataset": "2x",
  "datasets": {
    "1x": {
      "aliases": ["1x", "geant-1x", "geant_1x"],
      "name": "GEANT full shared-path 1x",
      "topology": "geant_full_shared_load1x_train",
      "load_factor": 1.0,
      "strict_esm": true,
      "train": [0, 6000],
      "validation": [6000, 7500],
      "test": [7500, 10200],
      "runtime": "test_diff_path/full_geant_1x_hattrick/run_full_experiment.py",
      "baseline": {
        "method": "Hattrick",
        "selection_file": "test_diff_path/full_geant_1x_hattrick/artifacts/hattrick/seed_{seed}/complete.json",
        "selection_field": "selected_epoch"
      }
    },
    "2x": {
      "aliases": ["2x", "geant-2x", "geant_2x"],
      "name": "GEANT full shared-path 2x",
      "topology": "geant_full_shared_load2x_train",
      "load_factor": 2.0,
      "strict_esm": true,
      "train": [0, 6000],
      "validation": [6000, 7500],
      "test": [7500, 10200],
      "runtime": "test_diff_path/full_geant_2x_hattrick_f/run_full_experiment.py",
      "baseline": {"method": "Hattrick", "epoch": 22}
    },
    "3x": {
      "aliases": ["3x", "geant-3x", "geant_3x"],
      "name": "GEANT full shared-path 3x",
      "topology": "geant_full_shared_load3x_train",
